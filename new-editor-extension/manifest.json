{
  "manifest_version": 3,
  "name": "SMMplanner New Editor Helper",
  "version": "1.1.1",
  "description": "Paste, page selection, video titles and published links for the new SMMplanner editor.",
  "permissions": [
    "clipboardRead",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://smmplanner.com/home/new_posts*",
        "https://smmplanner.com/home/post_v3*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
